{
  // ===== Configuración de logging =====
  // LogLevel Default: Information. Queda todo lo "técnicamente normal" visible.
  // Microsoft.AspNetCore lo bajamos a Warning para no llenar la consola de spam de
  // hosting cada vez que se hace un request 200 sin importancia.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // "*" significa "acepta conexiones entrantes desde cualquier Host header".
  // Para local no hay problema; en producción lo ajustas al dominio real.
  "AllowedHosts": "*",

  // ===== Cadenas de conexión =====
  // ApplicationDbContext lee "DefaultConnection" a través de:
  //   builder.Configuration.GetConnectionString("DefaultConnection")
  //
  // Desglose:
  //   Server=localhost\SQLEXPRESS          -> instancia local de SQL Server Express
  //   Database=SistemaTallerBicicletasDb   -> nombre de la base que creará EF
  //   Trusted_Connection=True              -> autenticación con tu usuario de Windows
  //   TrustServerCertificate=True          -> evita errores TLS/SSL localmente con certificado autofirmado
  //   MultipleActiveResultSets=true        -> permite abrir varios DataReaders sobre la misma conexión
  //                                            (útil en algunos queries de EF con Include/Select anidados)
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost\\SQLEXPRESS;Database=SistemaTallerBicicletasDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  }
}
